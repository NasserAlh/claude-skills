<Window x:Class="OpenOsk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenOSK"
        Width="1000"
        Height="360"
        MinWidth="420"
        MinHeight="200"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        ShowActivated="False"
        Topmost="True"
        ShowInTaskbar="True"
        Focusable="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Stylus.IsPressAndHoldEnabled="False"
        Stylus.IsFlicksEnabled="False"
        Stylus.IsTapFeedbackEnabled="False"
        Stylus.IsTouchFeedbackEnabled="False"
        FontFamily="{StaticResource UiFont}"
        Background="{DynamicResource WindowBackground}">
  <WindowChrome.WindowChrome>
    <WindowChrome x:Name="Chrome"
                  CaptionHeight="30"
                  ResizeBorderThickness="6"
                  GlassFrameThickness="0"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="30" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Title bar -->
    <Grid Grid.Row="0" Background="{DynamicResource TitleBackground}">
      <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TitleForeground}" />
        <TextBlock Text="OpenOSK" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TitleForeground}" />
        <TextBlock x:Name="ModeLabel" Margin="10,0,0,0" FontSize="11" VerticalAlignment="Center" Opacity="0.7" Foreground="{DynamicResource TitleForeground}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Style="{StaticResource TitleButton}" Content="&#xE713;" ToolTip="Options" Click="OnOptionsClick" />
        <Button Style="{StaticResource TitleButton}" Content="&#xE921;" ToolTip="Minimize" Click="OnMinimizeClick" />
        <Button Style="{StaticResource TitleCloseButton}" Content="&#xE8BB;" ToolTip="Close" Click="OnCloseClick" />
      </StackPanel>
    </Grid>

    <!-- Word predictions -->
    <!-- Auto height: a fixed 38 pushed the chip text under the key rows. -->
    <Border x:Name="PredictionBar" Grid.Row="1" Padding="4,2" Visibility="Collapsed">
      <UniformGrid x:Name="PredictionPanel" Rows="1" />
    </Border>

    <!-- Keys: main block | numeric pad | command column -->
    <Grid x:Name="KeysHost" Grid.Row="2" Margin="4,2,4,4" SizeChanged="OnKeysHostSizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="MainColumn" Width="*" />
        <ColumnDefinition x:Name="NumPadColumn" Width="0" />
        <ColumnDefinition x:Name="CommandColumn" Width="0" />
      </Grid.ColumnDefinitions>
      <Grid x:Name="MainBlock" Grid.Column="0" />
      <Grid x:Name="NumPadBlock" Grid.Column="1" Margin="6,0,0,0" />
      <Grid x:Name="CommandBlock" Grid.Column="2" Margin="6,0,0,0" />
    </Grid>
  </Grid>
</Window>
