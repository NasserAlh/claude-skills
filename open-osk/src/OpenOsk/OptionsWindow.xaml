<Window x:Class="OpenOsk.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenOSK Options"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource KeyForeground}">
  <Window.Resources>
    <Style TargetType="GroupBox">
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Foreground" Value="{DynamicResource KeyForeground}" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="Foreground" Value="{DynamicResource KeyForeground}" />
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="Foreground" Value="{DynamicResource KeyForeground}" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource KeyForeground}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="IsSnapToTickEnabled" Value="True" />
      <Setter Property="TickFrequency" Value="0.1" />
    </Style>
  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="760">
    <StackPanel Margin="16">
      <CheckBox x:Name="ClickSoundBox" Content="Use click sound" />
      <CheckBox x:Name="CommandKeysBox" Content="Show keys to make it easier to move around the screen (Nav, Mv Up, Mv Dn, Dock, Fade)" />
      <CheckBox x:Name="NumPadBox" Content="Turn on numeric key pad" />

      <GroupBox Header="To use the On-Screen Keyboard" Margin="0,10,0,10">
        <StackPanel>
          <RadioButton x:Name="ClickMode" Content="Click on keys" GroupName="Mode" />
          <RadioButton x:Name="HoverMode" Content="Hover over keys" GroupName="Mode" />
          <Grid Margin="24,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="60" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Hover duration" />
            <Slider x:Name="HoverSlider" Grid.Column="1" Minimum="0.5" Maximum="3" />
            <TextBlock x:Name="HoverValue" Grid.Column="2" HorizontalAlignment="Right" />
          </Grid>
          <RadioButton x:Name="ScanMode" Content="Scan through keys" GroupName="Mode" />
          <Grid Margin="24,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="60" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Scanning speed" />
            <Slider x:Name="ScanSlider" Grid.Column="1" Minimum="0.5" Maximum="3" />
            <TextBlock x:Name="ScanValue" Grid.Column="2" HorizontalAlignment="Right" />
          </Grid>
          <TextBlock Text="Select a key by:" Margin="24,4,0,0" />
          <StackPanel Orientation="Horizontal" Margin="24,0,0,0">
            <CheckBox x:Name="ScanKeyBox" Content="Keyboard key" />
            <ComboBox x:Name="ScanKeyCombo" Width="120" Margin="8,0,16,0" VerticalAlignment="Center" />
            <CheckBox x:Name="ScanMouseBox" Content="Mouse click" />
          </StackPanel>
        </StackPanel>
      </GroupBox>

      <GroupBox Header="Use Text Prediction">
        <StackPanel>
          <CheckBox x:Name="PredictionsBox" Content="Show text predictions" />
          <CheckBox x:Name="SpaceAfterBox" Content="Insert space after predicted words" Margin="24,4,0,4" />
          <CheckBox x:Name="LearnWordsBox" Content="Learn the words I type (stored only on this PC)" Margin="24,4,0,4" />
          <Button x:Name="ForgetButton" Content="Forget learned words" HorizontalAlignment="Left" Margin="24,4,0,2" Padding="10,3" Click="OnForgetClick" />
        </StackPanel>
      </GroupBox>

      <GroupBox Header="Keyboard">
        <StackPanel>
          <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Layout" Margin="0,0,12,0" />
            <ComboBox x:Name="LayoutCombo" Grid.Column="1" />
          </Grid>
          <CheckBox x:Name="RepeatBox" Content="Repeat a key while it is held down" />
          <CheckBox x:Name="ModifierLockBox" Content="Tapping Shift, Ctrl, Alt or Win twice locks it (tap again to release)" />
          <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,2,0,0"
                     Text="Key labels always follow the input language of the application you are typing into." />
        </StackPanel>
      </GroupBox>

      <GroupBox Header="Appearance">
        <StackPanel>
          <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Theme" Margin="0,0,12,0" />
            <ComboBox x:Name="ThemeCombo" Grid.Column="1" />
          </Grid>
          <Grid Margin="0,6,0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="60" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Fade opacity" />
            <Slider x:Name="FadeSlider" Grid.Column="1" Minimum="0.1" Maximum="1" />
            <TextBlock x:Name="FadeValue" Grid.Column="2" HorizontalAlignment="Right" />
          </Grid>
        </StackPanel>
      </GroupBox>

      <GroupBox Header="Startup">
        <StackPanel>
          <CheckBox x:Name="StartupBox" Content="Start OpenOSK when I sign in" />
          <CheckBox x:Name="StartDockedBox" Content="Start docked to the bottom of the screen" />
          <CheckBox x:Name="StartNavBox" Content="Start in navigation mode" />
        </StackPanel>
      </GroupBox>

      <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,10"
                 Text="OpenOSK has no telemetry, makes no network connections and stores its settings only on this PC." />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="OK" Width="90" Padding="0,4" Margin="0,0,8,0" IsDefault="True" Click="OnOkClick" />
        <Button Content="Cancel" Width="90" Padding="0,4" IsCancel="True" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
