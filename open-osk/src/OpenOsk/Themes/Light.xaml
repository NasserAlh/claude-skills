<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Windows 11 light palette -->
  <SolidColorBrush x:Key="WindowBackground" Color="#F3F3F3" />
  <SolidColorBrush x:Key="TitleBackground" Color="#F3F3F3" />
  <SolidColorBrush x:Key="TitleForeground" Color="#1B1B1B" />
  <SolidColorBrush x:Key="TitleButtonHover" Color="#E5E5E5" />
  <SolidColorBrush x:Key="TitleCloseHover" Color="#C42B1C" />
  <SolidColorBrush x:Key="TitleCloseHoverForeground" Color="#FFFFFF" />

  <SolidColorBrush x:Key="KeyBackground" Color="#FDFDFD" />
  <SolidColorBrush x:Key="KeyForeground" Color="#1B1B1B" />
  <SolidColorBrush x:Key="KeyBorder" Color="#D9D9D9" />
  <SolidColorBrush x:Key="KeyHover" Color="#F0F0F0" />
  <SolidColorBrush x:Key="KeyPressed" Color="#D6D6D6" />
  <SolidColorBrush x:Key="ActionKeyBackground" Color="#EDEDED" />
  <SolidColorBrush x:Key="CommandKeyBackground" Color="#DCE7F4" />
  <SolidColorBrush x:Key="CommandKeyForeground" Color="#0F3A6E" />

  <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
  <SolidColorBrush x:Key="LatchedBackground" Color="#CCE4F7" />
  <SolidColorBrush x:Key="LockedBackground" Color="#0067C0" />
  <SolidColorBrush x:Key="LockedForeground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="HighlightBackground" Color="#FFE9A8" />
  <SolidColorBrush x:Key="HighlightBorder" Color="#C58A00" />

  <SolidColorBrush x:Key="PredictionBackground" Color="#E9E9E9" />
  <SolidColorBrush x:Key="PredictionForeground" Color="#1B1B1B" />
  <SolidColorBrush x:Key="PredictionHover" Color="#DADADA" />
</ResourceDictionary>
