<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Windows 11 dark palette -->
  <SolidColorBrush x:Key="WindowBackground" Color="#202020" />
  <SolidColorBrush x:Key="TitleBackground" Color="#202020" />
  <SolidColorBrush x:Key="TitleForeground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="TitleButtonHover" Color="#3A3A3A" />
  <SolidColorBrush x:Key="TitleCloseHover" Color="#C42B1C" />
  <SolidColorBrush x:Key="TitleCloseHoverForeground" Color="#FFFFFF" />

  <SolidColorBrush x:Key="KeyBackground" Color="#2D2D2D" />
  <SolidColorBrush x:Key="KeyForeground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="KeyBorder" Color="#3A3A3A" />
  <SolidColorBrush x:Key="KeyHover" Color="#383838" />
  <SolidColorBrush x:Key="KeyPressed" Color="#4A4A4A" />
  <SolidColorBrush x:Key="ActionKeyBackground" Color="#262626" />
  <SolidColorBrush x:Key="CommandKeyBackground" Color="#263445" />
  <SolidColorBrush x:Key="CommandKeyForeground" Color="#9CC9FF" />

  <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
  <SolidColorBrush x:Key="LatchedBackground" Color="#1F4A6A" />
  <SolidColorBrush x:Key="LockedBackground" Color="#4CC2FF" />
  <SolidColorBrush x:Key="LockedForeground" Color="#000000" />
  <SolidColorBrush x:Key="HighlightBackground" Color="#6B5300" />
  <SolidColorBrush x:Key="HighlightBorder" Color="#FFD44D" />

  <SolidColorBrush x:Key="PredictionBackground" Color="#2B2B2B" />
  <SolidColorBrush x:Key="PredictionForeground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="PredictionHover" Color="#3C3C3C" />
</ResourceDictionary>
