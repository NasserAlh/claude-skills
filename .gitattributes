# Normalise line endings to LF in the repository and on checkout, matching .editorconfig,
# so Git for Windows' core.autocrlf=true does not turn every file into a diff.
* text=auto eol=lf

# Windows-only files that tools expect with CRLF
*.sln text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary
*.png binary
*.ico binary
*.wav binary
*.zip binary
